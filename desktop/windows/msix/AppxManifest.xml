<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package (MSIX) of the Windows app; desktop/tool/make_msix.ps1 fills in the version.
     Identity: Partner Center, Product management > Product identity (app "Waaiya", Store ID 9NBB296FSRJP). These
     values must stay exactly as they are: the Store refuses a package whose identity differs. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop rescap">

  <Identity Name="Oks.Waaiya" Publisher="CN=C31050E3-9E33-47EF-9D5C-040742962A92" Version="@VERSION@"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Waaiya</DisplayName>
    <PublisherDisplayName>Oks</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Removes music from the sound of every app and keeps the voices; blurs pictures you choose not to see.</Description>
  </Properties>

  <!-- process loopback (the sound filter's capture) needs Windows 10 version 2004 -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ar" />
    <Resource Language="fr" />
  </Resources>

  <Applications>
    <Application Id="Waaiya" Executable="waaiya_desktop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Waaiya" Description="Waaiya: music removed, voices kept"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start at login": a package cannot use the Run key. This runs at every login and filters only when the
             app's "Start at login" is on; otherwise it only gives apps their sound back if the computer was turned
             off while filtering (waaiya-filter autostart). Users can turn it off in Settings > Apps > Startup. -->
        <desktop:Extension Category="windows.startupTask" Executable="engine\waaiya-filter.exe"
                           EntryPoint="Windows.FullTrustApplication" uap10:Parameters="autostart">
          <desktop:StartupTask TaskId="WaaiyaFilter" Enabled="true" DisplayName="Waaiya" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- an ordinary Windows program (Flutter app, sound filter, screen blur), not a sandboxed app -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
