<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Saving a link without music: download (data sync) and audio processing (media processing, Android 15+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Granted once by the user over ADB/Shizuku; lets the app list other apps' audio sessions to mute the originals. -->
    <uses-permission android:name="android.permission.DUMP" tools:ignore="ProtectedPermissions" />
    <!-- Screen blur without the accessibility service: covers drawn as an app overlay (touches on a cover are lost). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+ package visibility: detect "Shizuku installed but not running" and open it. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <!-- Apps with a launcher icon: to name the app whose sound cannot be filtered ("X does not allow filtering"). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Our own filtered output must never be captured again (no feedback loop). -->
    <!-- Arabic first, English on request (Lang.kt). localeConfig lists both for Android 13+'s per-app language. -->
    <application
        android:name=".WaaiyaApp"
        android:localeConfig="@xml/locales_config"
        android:allowAudioPlaybackCapture="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.IslamicMute">

        <!-- Main screen: the shared Flutter screens (ui/, docs/UI_CONTRACT.md). The launcher entry keeps the name
             ".MainActivity" so existing home-screen icons and the notification keep working. With -PimNativeUi,
             src/nativeUi/AndroidManifest.xml makes the old native MainActivity the launcher instead.
             configChanges: Flutter redraws itself, and a language switch must not restart the screen. -->
        <activity android:name=".UiActivity" android:exported="false"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />
        <activity-alias android:name=".MainActivity" android:targetActivity=".UiActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity android:name=".LicencesActivity" android:exported="false" />

        <!-- "Share to" / "Open with" player: perfect lip-sync for videos from WhatsApp, Telegram, files. -->
        <activity android:name=".PlayerActivity" android:exported="true" android:theme="@style/Theme.IslamicMute.Player"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="video/*" />
                <data android:scheme="content" android:mimeType="audio/*" />
                <data android:scheme="file" android:mimeType="video/*" />
                <data android:scheme="file" android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- The same player for a resolved web link (stream URLs and the headers they need). Not exported: the
             exported player above ignores a stream list, so no other app can make Waaiya fetch URLs with chosen
             headers. -->
        <activity android:name=".LinkPlayerActivity" android:exported="false" android:theme="@style/Theme.IslamicMute.Player"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Paste or share a link (YouTube, TikTok, ...): watch, save or share it without music. -->
        <activity android:name=".LinkActivity" android:exported="true" android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Shizuku sends its binder to the app through this provider (as documented by Shizuku-API). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service android:name=".LinkExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <!-- One-time setup over Wireless debugging (Android 11+): pairs with the phone's own adbd while the user is in
             Settings, then grants DUMP and PROJECT_MEDIA. A local network exchange of a few minutes at most. -->
        <service android:name=".WirelessSetupService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Screen blur's accessibility service (touches pass through the covers) is only in builds made with
             -PimBlurA11y: src/blurA11y/AndroidManifest.xml. Play Protect blocks sideloaded apps that declare one. -->
        <service android:name=".FilterService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
