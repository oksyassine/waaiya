<?xml version="1.0" encoding="utf-8"?>
<!-- Paste or share a link: open it, then watch or save it without music. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="4dp" android:paddingTop="4dp" android:paddingEnd="16dp"
        android:paddingBottom="4dp">
        <ImageButton android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_button_text" android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back" />
        <TextView style="@style/Text.Headline" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:paddingStart="8dp" android:text="@string/link_title"
            android:accessibilityHeading="true" />
    </LinearLayout>

    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="32dp">

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView android:id="@+id/link_label" style="@style/Text.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/link_field_label" android:labelFor="@+id/link_input" />
                <EditText android:id="@+id/link_input" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:minHeight="52dp" android:background="@drawable/bg_field"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="textUri"
                    android:imeOptions="actionGo" android:hint="@string/link_hint" android:textSize="16sp"
                    android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
                    android:textDirection="ltr" android:textAlignment="viewStart" android:singleLine="true" android:importantForAutofill="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                    android:layout_marginTop="12dp" android:gravity="center_vertical|end">
                    <Button android:id="@+id/paste" style="@style/Button.Text" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/link_paste" />
                    <Button android:id="@+id/open" style="@style/Button.Filled" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/link_open" />
                </LinearLayout>
                <LinearLayout android:id="@+id/resolving" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp" android:visibility="gone">
                    <ProgressBar android:layout_width="24dp" android:layout_height="24dp" android:indeterminateTint="@color/primary" />
                    <TextView style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:text="@string/link_resolving" />
                </LinearLayout>
                <TextView android:id="@+id/link_error" style="@style/Text.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/error"
                    android:accessibilityLiveRegion="polite" android:visibility="gone" />
            </LinearLayout>

            <!-- What the link points to, and the two actions. -->
            <LinearLayout android:id="@+id/result" style="@style/Card" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:visibility="gone">
                <TextView android:id="@+id/result_title" style="@style/Text.Section" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:maxLines="3" android:ellipsize="end" />
                <TextView android:id="@+id/result_meta" style="@style/Text.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                <Button android:id="@+id/watch" style="@style/Button.Filled" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="16dp"
                    android:text="@string/link_watch" />
                <Button android:id="@+id/save" style="@style/Button.Tonal" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp"
                    android:text="@string/link_save" />
            </LinearLayout>

            <!-- Saving: progress, then the result. -->
            <LinearLayout android:id="@+id/export" style="@style/Card" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:visibility="gone">
                <TextView android:id="@+id/export_title" style="@style/Text.Body" android:fontFamily="sans-serif-medium"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" />
                <TextView android:id="@+id/export_state" style="@style/Text.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:accessibilityLiveRegion="polite" />
                <ProgressBar android:id="@+id/export_progress" style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:max="100" android:progressTint="@color/primary" android:indeterminateTint="@color/primary" />
                <Button android:id="@+id/export_cancel" style="@style/Button.Text" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="4dp"
                    android:text="@string/link_cancel" />
                <LinearLayout android:id="@+id/export_done" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp" android:visibility="gone">
                    <Button android:id="@+id/play_saved" style="@style/Button.Filled" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/link_play" />
                    <Button android:id="@+id/share_saved" style="@style/Button.Tonal" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="@string/link_share" />
                </LinearLayout>
                <TextView android:id="@+id/share_note" style="@style/Text.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/link_share_note"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
