<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="true" android:background="@color/bg">

    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp">

        <TextView style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:accessibilityHeading="true" />
        <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/tagline" />

        <!-- First run: asked once, changeable in Settings. -->
        <LinearLayout android:id="@+id/onboarding" style="@style/Card" android:layout_marginTop="24dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
            <!-- first screen: switch to the other language in one tap (shows that language's own name) -->
            <Button android:id="@+id/onboard_language" style="@style/Button.Text" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="end" />
            <TextView style="@style/Text.Headline" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/onboard_title" android:accessibilityHeading="true" />
            <TextView style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/onboard_body" />
            <TextView style="@style/Text.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/onboard_question" />
            <Button android:id="@+id/choose_man" style="@style/Button.Tonal" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp"
                android:text="@string/gender_man" />
            <Button android:id="@+id/choose_woman" style="@style/Button.Tonal" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp"
                android:text="@string/gender_woman" />
            <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/onboard_why" />
        </LinearLayout>

        <LinearLayout android:id="@+id/main" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Primary action: one large on/off control, state also in words (not colour alone). -->
            <ImageButton android:id="@+id/power" android:layout_width="152dp" android:layout_height="152dp"
                android:layout_gravity="center_horizontal" android:layout_marginTop="32dp"
                android:background="@drawable/bg_power" android:src="@drawable/ic_power"
                android:scaleType="fitCenter" android:padding="44dp" />
            <TextView android:id="@+id/state_title" style="@style/Text.Headline" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:textAlignment="center"
                android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/state_detail" style="@style/Text.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textAlignment="center"
                android:accessibilityLiveRegion="polite" />
            <!-- Filtering stopped by itself while other apps stay silenced: the way to hear them unfiltered. -->
            <Button android:id="@+id/release_silence" style="@style/Button.Tonal" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp" android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp" android:text="@string/release_silence" android:visibility="gone" />
            <TextView android:id="@+id/capture_hint" style="@style/Text.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textAlignment="center"
                android:text="@string/capture_hint" />

            <!-- Shown until the one-time setup is done. -->
            <LinearLayout android:id="@+id/setup_banner" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:background="@drawable/bg_warning" android:orientation="horizontal"
                android:padding="16dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_warning"
                    android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" android:textColor="@color/on_warning_container" android:textAlignment="viewStart"
                        android:text="@string/setup_banner_title" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp"
                        android:layout_marginTop="2dp" android:textColor="@color/on_warning_container" android:textAlignment="viewStart"
                        android:text="@string/setup_banner_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/setup_card" style="@style/Card" android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView style="@style/Text.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/setup_title" android:accessibilityHeading="true" />
                <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/setup_body" />
                <include android:id="@+id/step1" layout="@layout/item_step" />
                <include android:id="@+id/step2" layout="@layout/item_step" />
                <include android:id="@+id/step3" layout="@layout/item_step" />
                <TextView android:id="@+id/setup_message" style="@style/Text.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textIsSelectable="true"
                    android:accessibilityLiveRegion="polite" android:visibility="gone" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="20dp"
                    android:background="@color/outline" />
                <Button android:id="@+id/computer_toggle" style="@style/Button.Text" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical|start"
                    android:drawableEnd="@drawable/ic_chevron" android:text="@string/computer_toggle" />
                <LinearLayout android:id="@+id/computer_box" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/computer_body" />
                    <TextView android:id="@+id/adb_commands" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:background="@drawable/bg_code" android:padding="12dp"
                        android:fontFamily="monospace" android:textSize="13sp" android:textColor="@color/text_primary"
                        android:textDirection="ltr" android:textAlignment="viewStart" android:layoutDirection="ltr"
                        android:textIsSelectable="true" />
                    <Button android:id="@+id/copy_adb" style="@style/Button.Text" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:drawableStart="@drawable/ic_copy"
                        android:drawablePadding="8dp" android:text="@string/copy" />
                    <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/computer_note" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Text.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/link_entry_title" android:accessibilityHeading="true" />
                <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/link_entry_body" />
                <Button android:id="@+id/open_link" style="@style/Button.Tonal" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/link_open" />
            </LinearLayout>

            <!-- Screen blur: covers women (and people not clearly men) and immodest images over every app. -->
            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Text.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/blur_title" android:accessibilityHeading="true" />
                <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/blur_body" />
                <Switch android:id="@+id/switch_blur_women" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:layout_marginTop="8dp" android:textSize="16sp"
                    android:textColor="@color/text_primary" android:text="@string/blur_women_title" />
                <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingEnd="56dp" android:text="@string/blur_women_body" />
                <Switch android:id="@+id/switch_blur_nudity" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:layout_marginTop="12dp" android:textSize="16sp"
                    android:textColor="@color/text_primary" android:text="@string/blur_nudity_title" />
                <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingEnd="56dp" android:text="@string/blur_nudity_body" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="48dp">
                    <TextView android:id="@+id/blur_strict_value" style="@style/Text.Body" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1" />
                    <Button android:id="@+id/change_blur_strict" style="@style/Button.Text" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/change" />
                </LinearLayout>
                <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingEnd="56dp" android:text="@string/blur_strict_help" />
                <Switch android:id="@+id/switch_blur_fail" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:layout_marginTop="12dp" android:textSize="16sp"
                    android:textColor="@color/text_primary" android:text="@string/blur_fail_title" />
                <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingEnd="56dp" android:text="@string/blur_fail_body" />
                <TextView android:id="@+id/blur_fail_note" style="@style/Text.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:paddingEnd="56dp"
                    android:textColor="@color/primary" android:visibility="gone" />
                <Button android:id="@+id/blur_fail_fix" style="@style/Button.Text" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:visibility="gone" />
                <TextView android:id="@+id/blur_status" style="@style/Text.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone"
                    android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/blur_setup" style="@style/Button.Tonal" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone"
                    android:text="@string/blur_setup_shizuku" />
                <Button android:id="@+id/blur_setup_manual" style="@style/Button.Text" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:visibility="gone" android:text="@string/blur_setup_manual" />
            </LinearLayout>

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Text.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_title" android:accessibilityHeading="true" />
                <Switch android:id="@+id/switch_silence" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:layout_marginTop="8dp" android:textSize="16sp"
                    android:textColor="@color/text_primary" android:text="@string/setting_silence_title" />
                <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingEnd="56dp" android:text="@string/setting_silence_body" />
                <Switch android:id="@+id/switch_hold_silence" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:layout_marginTop="16dp" android:textSize="16sp"
                    android:textColor="@color/text_primary" android:text="@string/setting_hold_silence_title" />
                <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingEnd="56dp" android:text="@string/setting_hold_silence_body" />
                <Switch android:id="@+id/switch_stereo" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:layout_marginTop="16dp" android:textSize="16sp"
                    android:textColor="@color/text_primary" android:text="@string/setting_stereo_title" />
                <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingEnd="56dp" android:text="@string/setting_stereo_body" />
                <LinearLayout android:id="@+id/singing_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginTop="16dp">
                    <Switch android:id="@+id/switch_singing" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:textSize="16sp" android:textColor="@color/text_primary"
                        android:text="@string/setting_singing_title" />
                    <TextView android:id="@+id/singing_body" style="@style/Text.Secondary" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:paddingEnd="56dp" />
                </LinearLayout>
                <TextView android:id="@+id/restart_note" style="@style/Text.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/primary"
                    android:text="@string/setting_restart" android:visibility="gone" android:accessibilityLiveRegion="polite" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="48dp">
                    <TextView android:id="@+id/gender_value" style="@style/Text.Body" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1" />
                    <Button android:id="@+id/change_gender" style="@style/Button.Text" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/change" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="48dp">
                    <TextView android:id="@+id/language_value" style="@style/Text.Body" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1" />
                    <Button android:id="@+id/change_language" style="@style/Button.Text" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/change" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Text.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/player_title" android:accessibilityHeading="true" />
                <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/player_body" />
            </LinearLayout>

            <Button android:id="@+id/diagnostics" style="@style/Button.Text" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"
                android:text="@string/diag_button" />
            <Button android:id="@+id/licences" style="@style/Button.Text" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
                android:text="@string/licences" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
