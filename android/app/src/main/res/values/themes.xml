<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework DayNight theme (no AppCompat). Edge-to-edge: the main screen applies the system-bar insets itself. -->
    <style name="Theme.IslamicMute" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <!-- Video player: always dark, full screen. -->
    <style name="Theme.IslamicMute.Player" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#7AD8C6</item>
    </style>

    <style name="Text"><item name="android:textAlignment">viewStart</item></style>
    <style name="Button" />
    <style name="Text.Title"><item name="android:textSize">28sp</item><item name="android:textColor">@color/text_primary</item><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="Text.Headline"><item name="android:textSize">20sp</item><item name="android:textColor">@color/text_primary</item><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="Text.Section"><item name="android:textSize">18sp</item><item name="android:textColor">@color/text_primary</item><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="Text.Body"><item name="android:textSize">16sp</item><item name="android:textColor">@color/text_primary</item><item name="android:lineSpacingMultiplier">1.2</item></style>
    <style name="Text.Secondary"><item name="android:textSize">14sp</item><item name="android:textColor">@color/text_secondary</item><item name="android:lineSpacingMultiplier">1.2</item></style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">20dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>
    <style name="Button.Filled">
        <item name="android:background">@drawable/bg_button_filled</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Button.Tonal" parent="Button.Filled">
        <item name="android:background">@drawable/bg_button_tonal</item>
        <item name="android:textColor">@color/on_primary_container</item>
    </style>
    <style name="Button.Text" parent="Button.Filled">
        <item name="android:background">@drawable/bg_button_text</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
</resources>
