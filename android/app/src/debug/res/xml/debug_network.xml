<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the emulator fetch test files over plain HTTP from the host (10.0.2.2), for the
     link-export sync test. Release builds keep Android's default (HTTPS only). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
